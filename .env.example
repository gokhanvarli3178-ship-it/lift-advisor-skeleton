# --- AI advisor (the ONLY feature that needs internet) -----------------------
# Full URL of the AI gateway the client calls (your own proxy; never put a
# provider API key in a NEXT_PUBLIC_* variable).
NEXT_PUBLIC_AI_ENDPOINT=

# Optional lightweight health URL (HEAD request). When set, the app probes it
# instead of trusting navigator.onLine alone (captive portals, no-uplink LANs).
NEXT_PUBLIC_AI_HEALTH_URL=
