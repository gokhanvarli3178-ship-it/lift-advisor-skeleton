{
  "name": "lift-advisor",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first advisory PWA for lifting equipment and occupational safety (TR/EN).",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cap": "node scripts/clean-sw.mjs && cross-env BUILD_TARGET=capacitor next build",
    "start": "serve out -l 3000",
    "preview": "npm run build && npm run start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "icons": "python3 scripts/generate-icons.py",
    "verify": "npm run i18n:check && npm run typecheck && npm run lint && npm run build",
    "cap:sync": "npm run build:cap && cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "i18next": "^27.1.5",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.74.0",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/eslintrc": "^3.3.7",
    "@serwist/next": "^9.5.15",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.33",
    "serve": "^14.2.8",
    "serwist": "^9.5.15",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  }
}
